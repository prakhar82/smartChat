{
  "name": "smartchat-mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "npm run build:web && npx cap copy",
    "build:web": "cd ../frontend && npm run build",
    "sync": "npx cap sync",
    "android": "npm run build && npx cap open android",
    "ios": "npm run build && npx cap open ios",
    "electron:dev": "concurrently \"(cd ../frontend && npm run build -- --watch)\" \"wait-on ../frontend/dist/index.html && electron .\"",
    "electron:pack": "electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "wait-on": "^7.0.1"
  }
}

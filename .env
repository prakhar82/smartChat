###############################################################################
# SmartChat Environment Configuration
# -----------------------------------
# This file defines environment variables for local development and deployment
# of the SmartChat application stack (Spring Boot API, PostgreSQL, MongoDB,
# Redis, optional MarkLogic, and Angular/Ionic frontend).
#
# Usage:
#   - Place this file at the project root.
#   - Docker Compose automatically loads it with `env_file: .env`.
#   - To override, export variables manually or pass `--env-file` to compose.
#
# Copyright (c) 2025, SmartChat Contributors
# All rights reserved. Unauthorized copying or distribution of this file,
# via any medium, is strictly prohibited unless permitted by license.
###############################################################################

# =========================
# Shared Settings
# =========================
PROFILE=dev                     # Spring profile: dev | prod
TZ=Asia/Kolkata                 # Default timezone inside containers

# =========================
# Backend (Spring Boot API)
# =========================
API_PORT=8080                   # API exposed port on host
# Multiple origins allowed, comma-separated (no quotes needed here)
CORS_ORIGINS=http://localhost:4200,http://localhost

# =========================
# Debugging
# =========================
ENABLE_DEBUG=true              # true = enable JVM remote debug on port 5005
DEBUG_SUSPEND=n
DEBUG_PORT=5005                # JVM debug port

# =========================
# PostgreSQL Database
# =========================
POSTGRES_DB=smartchat           # Database name
POSTGRES_USER=smartchat         # Database username
POSTGRES_PASSWORD=smartchat_pw  # Database password
POSTGRES_PORT=5432              # Host port mapping

# =========================
# MongoDB Database
# =========================
MONGO_INITDB_ROOT_USERNAME=root   # Mongo root user
MONGO_INITDB_ROOT_PASSWORD=change_me # Mongo root password
MONGO_DB=smartchat                # Database name for application
MONGO_PORT=27017                  # Host port mapping

# =========================
# Redis (In-memory cache)
# =========================
REDIS_PORT=6379                 # Host port mapping

# =========================
# MarkLogic (Optional Future Service)
# =========================
MARKLOGIC_ADMIN_USER=admin      # Admin username
MARKLOGIC_ADMIN_PASS=change_me  # Admin password
MARKLOGIC_PORT=8000             # Host port mapping
